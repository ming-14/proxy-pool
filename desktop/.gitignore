# 构建产物（python 运行时 + 我方 payload 副本）
node_modules/
staging/
dist/
.dev/

# 打包用图标：根 .gitignore 的 build/ 是给 Python 打包产物用的，
# Electron 侧把 build/ 当 electron-builder 的 buildResources 目录，需入版本库
!build/
build/*
!build/icon.ico

# 原生启动器（launcher/）：windres 中间产物与从 build/icon.ico 复制的副本不入库
launcher/*.res.o
launcher/icon.ico
