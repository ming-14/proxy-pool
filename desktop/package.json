{
  "name": "proxy-pool-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "proxy-pool 桌面封装（Electron）：启动器 + 内嵌 Python 3.11 运行时 + 托盘常驻",
  "main": "src/main.js",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "prepare:runtime": "node scripts/prepare.mjs",
    "make:icon": "python scripts/make-ico.py src/assets/icon.png build/icon.ico",
    "start": "electron .",
    "dist": "node scripts/dist.mjs",
    "test": "node --test \"tests/**/*.test.cjs\""
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  }
}